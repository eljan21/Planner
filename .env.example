# Google Cloud Console → APIs & Services → Credentials → OAuth Client ID (Web)
GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxx.apps.googleusercontent.com

# Uzun, təsadüfi sətir. Yaratmaq üçün: openssl rand -hex 32
JWT_SECRET=change-me

# Yalnız bu Gmail hesabları daxil ola bilər (vergüllə ayır). Boş qalsa, hər kəs daxil ola bilər.
ALLOWED_EMAILS=dostun@gmail.com

# Planlayıcının standart adı (istifadəçi Ayarlar-dan dəyişə bilər)
APP_NAME="Khaya's Planner"

# Serverdə (docker compose) istifadə olunan domen — Caddy bunun üçün avtomatik HTTPS alır
DOMAIN=tasks.example.com

# Yalnız lokal test üçün: Google olmadan "Demo giriş" düyməsi (production-da işləmir)
DEV_LOGIN=true
